indicator("✦ GXV SMT Divergences-Lite", overlay=true, max_labels_count=500, max_lines_count=500)
import Gregorius_XV/GXVAssetCorrelationUtils/1 as GXV

//==============================================================================
// Release identity / canonical author fingerprint
//==============================================================================
const string GXV_SMT_AUTHOR = "Gregorius_XV"
const string GXV_SMT_CANONICAL_PUBLISHER = "TradingView: Gregorius_XV"
const string GXV_SMT_RELEASE_NAME = "✦ GXV SMT Divergences-Lite"
const string GXV_SMT_RELEASE_VERSION = "v2.3.0-source-cycles"
const string GXV_SMT_RELEASE_DATE = "2026-09-14"
const string GXV_SMT_LICENSE = "MPL-2.0"
const string GXV_SMT_AUTHOR_FINGERPRINT = "GXV-SMT-LITE::ORIGINAL::GREGORIUS_XV::2026-07-08::v1.0.0"

// v2.3 acquisition contract: native time()/time_close() windows; chart-OHLC
// accumulation in each symbol's own execution context BEFORE request merging.
// Three companion contexts maximum, independent of the thirteen ranks. Main
// extreme coordinates remain local. Closed prices come from source rollover;
// developing prices use ordinary rollback and are never permanent close proof.
// Exact aggregation requires contained source bars and available start history.
// Native EOD feed parity and provider revisions are outside this guarantee.

//==============================================================================
// Inputs — GXV normal SMT module subset
//==============================================================================
g_smt = "SMT Visual Settings"
g_smt_gates = "SMT Gates Settings"
g_smt_ranks = "SMT Render Settings"
g_smt_sessions = "SMT Session Filter Settings"
g_smt_assets = "SMT Asset Pair Resolver Settings"

const string TIP_DYNAMIC_SMT_LABELS = "When enabled, hides SMT labels on the exact chart timeframe used as that SMT family's maximum calculation gate. 3M and 12M labels are excluded."
const string TIP_DISPLAY_CAP = "Maximum retained SMTs per timeframe, pair, and direction bucket."
const string TIP_NEARBY_ONLY = "Shows only SMTs whose endpoint is within the latest chart bars."
const string TIP_CLEANUP = "Controls conflict handling. All removes lower-priority conflicts; Bypass modes keep conflicts but fade the bypassed SMT; None disables cleanup."
const string TIP_AESTHETIC_BYPASS = "In Bypass cleanup modes, keeps conflicting SMTs visible with lower contrast instead of fully removing them."
const string TIP_BYPASS_LABELS = "Shows labels on faded bypassed SMTs. Turn off for cleaner charts."
const string TIP_SESSION_FILTER = "Filters SNTs using Sessions time windows"
const string TIP_AUTO_SESSION = "Automatically selects one session from the latest chart candle time. Timing fields are locked while Auto is on, but their stored values are still used."
const string TIP_MANUAL_PAIRS = "Manual Pairs inputs are for correlated assets. Current Asset is fetched from current chart asset."


